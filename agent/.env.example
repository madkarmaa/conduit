# The variables that compose.yaml reads. Copy this file to .env next to the compose file and fill
# in the secrets.

# Required. The secrets that the mod sends to each runner. Each needs at least 16 letters, digits or
# -._~+/ characters, such as the output of `openssl rand -hex 24`. The mod's config/conduit.json
# needs the same values in agents.full.runner.secret and agents.chat.runner.secret.
CONDUIT_FULL_SECRET=
CONDUIT_CHAT_SECRET=

# The runner image. Set it to a local build, such as conduit-agent, to test changes.
#CONDUIT_AGENT_IMAGE=ghcr.io/madkarmaa/conduit-agent:latest

# The memory and CPU each container may use. Raise them if a CLI runs out of memory.
#CONDUIT_FULL_MEMORY=1g
#CONDUIT_FULL_CPUS=1.0
#CONDUIT_CHAT_MEMORY=1g
#CONDUIT_CHAT_CPUS=1.0

# The API keys, CONDUIT_FULL_API_KEY and CONDUIT_CHAT_API_KEY, belong to the Minecraft server, not
# to this file. The mod sends them with each run. See the mod's README for its setup.
