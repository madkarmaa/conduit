{
    "schemaVersion": 1,
    "id": "conduit",
    "version": "${version}",
    "name": "Conduit",
    "description": "An AI bot for Minecraft servers.",
    "authors": ["MadKarma"],
    "contact": {},
    "license": "CC0-1.0",
    "icon": "assets/conduit/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "top.madkarma.conduit.Conduit",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": ["conduit.mixins.json"],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    }
}
