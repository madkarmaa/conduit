{
    "schemaVersion": 1,
    "id": "minecraft_grpc",
    "version": "${version}",
    "name": "Minecraft gRPC",
    "description": "A gRPC server that allows any kind of interaction with Minecraft.",
    "authors": [
        "madkarma"
    ],
    "contact": {},
    "license": "CC0-1.0",
    "icon": "assets/minecraft_grpc/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "top.madkarma.minecraft.grpc.MinecraftGRPC",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "minecraft_grpc.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    }
}
